{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardputer-bridge.local/schemas/event-v1.schema.json",
  "title": "Cardputer Bridge transition event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "event", "request_id", "action", "source", "mic_intent", "capture_gate", "ble_control_authenticated", "wifi_audio_authenticated", "virtual_mic_ready"],
  "properties": {
    "v": {"const": 1},
    "event": {"const": "transition"},
    "request_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["toggle_mic_intent", "control_link_lost"]},
    "source": {"enum": ["harness", "ble_control"]},
    "mic_intent": {"enum": ["muted", "live"]},
    "capture_gate": {"enum": ["closed", "open"]},
    "ble_control_authenticated": {"type": "boolean"},
    "wifi_audio_authenticated": {"type": "boolean"},
    "virtual_mic_ready": {"type": "boolean"}
  }
}
