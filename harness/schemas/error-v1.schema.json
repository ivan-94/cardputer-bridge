{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardputer-bridge.local/schemas/error-v1.schema.json",
  "title": "Cardputer Bridge harness error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "event", "request_id", "code"],
  "properties": {
    "v": {"const": 1},
    "event": {"const": "error"},
    "request_id": {"type": "string", "minLength": 1},
    "code": {"enum": ["command_schema_invalid", "reset_profile_unknown", "dispatch_unsupported", "command_unknown"]}
  }
}
