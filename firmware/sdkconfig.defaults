CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# The ADV has no PSRAM. Let MbedTLS release handshake buffers as soon as they
# are no longer needed so HTTPS OTA can coexist with BLE, Wi-Fi and audio.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# Keep the existing TLS configuration for OTA. Audio itself uses plaintext PCM
# and does not call MbedTLS or allocate cipher contexts.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTS_SEND_SERVICE_CHANGE_MANUAL=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# M5Unified initialization and the bridge's long-lived routing state exhausted
# an 8 KiB main task stack on physical Cardputer ADV hardware. Keep 4 KiB of
# explicit headroom for BLE/Wi-Fi startup callbacks and serial reconnects.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# Audio frames are 20 ms. A 1 ms tick keeps capture and transport responsive
# while leaving enough scheduling resolution for the double-buffered mic path.
CONFIG_FREERTOS_HZ=1000
