# Production OTA images are signed and verified against the public-key digest
# embedded in the currently running signed app. This protects remote updates
# without enabling hardware Secure Boot or burning eFuses.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/firmware-signing-rsa3072.pem"
